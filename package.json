{
  "name": "almoxtvc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "npm run dev:frontend",
    "dev:full": "concurrently \"npm run dev:frontend\" \"npm run backend\"",
    "dev:frontend": "react-router dev",
    "backend": "npm run start:dev --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "backend:start": "npm run start --prefix backend",
    "backend:typecheck": "npm run typecheck --prefix backend",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/typeorm": "^11.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-router/node": "7.13.2",
    "@react-router/serve": "7.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.3",
    "isbot": "^5.1.36",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "pg": "^8.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.13.2",
    "reflect-metadata": "^0.2.2",
    "recharts": "^3.8.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@react-router/dev": "7.13.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
